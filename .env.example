# Copy to .env (git-ignored) and change the values.
# The password is embedded in a database URL: use URL-safe characters only
# (letters, digits, - _ . ~), e.g. `openssl rand -hex 24`.
POSTGRES_PASSWORD=change-me
SFCI_LOG_LEVEL=INFO
# Must match the secret set on the GitHub webhook, e.g. `openssl rand -hex 32`.
SFCI_GITHUB_WEBHOOK_SECRET=
# GitHub App (docs/github-app.md). Needed for manual builds and cancellation.
SFCI_GITHUB_APP_ID=
# The App's PEM private key. Either a quoted multi-line value, or one line
# with literal \n between lines, e.g. `awk 'NR>1{printf "\\n"}{printf "%s",$0}' key.pem`.
SFCI_GITHUB_APP_PRIVATE_KEY=
# Audience of the GitHub Actions OIDC token on run reports. Must match the
# audience ci/post_report.sh requests (SFCI_OIDC_AUDIENCE there, default below).
SFCI_OIDC_AUDIENCE=siliconflow
